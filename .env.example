# Copy to .env (never commit .env). Every value is optional; defaults target Union's Nexus.

# Nexus base URL (must match Moodle's wwwroot exactly, no trailing slash)
NEXUS_URL=https://nexus.union.edu

# Moodle web service the token belongs to (the mobile service is the one SSO login issues)
NEXUS_SERVICE=moodle_mobile_app

# Optional: use an explicit web-service token instead of the one stored by `nexus-mcp login`.
# Leave empty. Never paste a real token into a committed file.
NEXUS_TOKEN=

# Where `nexus-mcp login` stores the token: auto (keyring, then file) | keyring | file
NEXUS_TOKEN_STORAGE=auto

# Timezone override (IANA name). By default the Moodle account timezone is used, then America/New_York.
NEXUS_TIMEZONE=

# URL scheme used to hand the SSO token back to the CLI (letters, digits, . + - only)
NEXUS_URL_SCHEME=nexusmcp
# Schemes the macOS handler app claims. Nexus forces the launch link to ltgopenlmsapp:// (Open LMS app).
NEXUS_HANDLER_SCHEMES=nexusmcp,ltgopenlmsapp

# HTTP settings
NEXUS_HTTP_TIMEOUT=30
NEXUS_MAX_CONCURRENCY=6

# Cache lifetimes in seconds (0 = no cache). Grades/submission status are always labelled when cached.
NEXUS_CACHE_COURSES_TTL=900
NEXUS_CACHE_COURSE_INFO_TTL=900
NEXUS_CACHE_ASSIGNMENTS_TTL=120
NEXUS_CACHE_GRADES_TTL=30
NEXUS_CACHE_SUBMISSION_TTL=30
NEXUS_CACHE_CALENDAR_TTL=120
NEXUS_CACHE_ANNOUNCEMENTS_TTL=120
NEXUS_CACHE_MATERIALS_TTL=600
